 58.     local n_participants = _N
 59.     restore
 60. 
.     quietly levelsof wave if !missing(`y') & touse, local(available_waves)
 61. 
.     local formatted_waves ""
 62.     local wave_list `available_waves'
 63.     local n_waves : word count `wave_list'
 64. 
.     if `n_waves' > 0 {
 65.         local i = 1
 66.         while `i' <= `n_waves' {
 67.             local start_wave : word `i' of `wave_list'
 68.             local end_wave `start_wave'
 69.             local j = `i' + 1
 70. 
.             while `j' <= `n_waves' {
 71.                 local next_wave : word `j' of `wave_list'
 72.                 if `next_wave' == `end_wave' + 1 {
 73.                     local end_wave `next_wave'
 74.                     local j = `j' + 1
 75.                 }
 76.                 else {
 77.                     continue, break
 78.                 }
 79.             }
 80. 
.             if `start_wave' == `end_wave' {
 81.                 local range "`start_wave'"
 82.             }
 83.             else if `end_wave' == `start_wave' + 1 {
 84.                 local range "`start_wave', `end_wave'"
 85.             }
 86.             else {
 87.                 local range "`start_wave'--`end_wave'"
 88.             }
 89. 
.             if "`formatted_waves'" == "" {
 90.                 local formatted_waves "`range'"
 91.             }
 92.             else {
 93.                 local formatted_waves "`formatted_waves', `range'"
 94.             }
 95. 
.             local i = `j'
 96.         }
 97.     }
 98. 
.     local n_obs_f : display %12.0fc `n_obs'
 99.     local n_participants_f : display %12.0fc `n_participants'
100.     local n_obs_f = trim("`n_obs_f'")
101.     local n_participants_f = trim("`n_participants_f'")
102. 
.     local this_alpha ""
103.     if "`y'" == "evaluativewellbeing" local this_alpha "0.90"
104.     if "`y'" == "hedonicwellbeing"    local this_alpha "0.81"
105.     if "`y'" == "cesd"                local this_alpha "0.80"
106.     if "`y'" == "loneliness"          local this_alpha "0.83"
107.     if "`y'" == "mobility"            local this_alpha "0.87"
108.     if "`this_alpha'" != "" local alpha_str "\$\alpha = `this_alpha'\$"
109.     else                    local alpha_str ""
110. 
.     local var_label_latex = subinstr("`var_label'", "{it:(rev.)}", "\textit{(
> rev.)}", .)
111. 
.     file write latex_table "`var_label_latex' & `alpha_str' & " %9.3f (`min_v
> al') " & " %9.3f (`max_val') " & \includegraphics[scale=.08]{../results/hist_
> `y'.pdf} & " %9.3f (`sd_between') " & " %9.3f (`sd_within') " & `formatted_wa
> ves' & `n_participants_f' & `n_obs_f' \\" _n
112. 
