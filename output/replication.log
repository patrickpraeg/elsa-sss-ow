r; t=0.00 8:01:07

. 
. foreach y in $continuous $binary {
  2.     di _n "=================== `y' ==================="
  3.     local isbin = 0
  4.     foreach bvar of global binary {
  5.         if "`y'" == "`bvar'" local isbin = 1
  6.     }
  7.     local isremap = 0
  8.     foreach rvar of global remap {
  9.         if "`y'" == "`rvar'" local isremap = 1
 10.     }
 11.     qui xtreg `y' sss $controls i.wave if touse, fe vce(cluster idauniq)
 12.     local b_fe_all = _b[sss]
 13.     local se_fe_all = _se[sss]
 14. 
.     preserve
 15.     capture drop tt
 16.     gen int tt = wave
 17.     if `isremap' {
 18.         qui levelsof wave if touse & !missing(`y'), local(ws)
 19.         replace tt = .
 20.         local k = 0
 21.         foreach w of local ws {
 22.             local ++k
 23.             replace tt = `k' if wave == `w'
 24.         }
 25.         di "re-indexed time points for `y': `ws'"
 26.         keep if !missing(tt)
 27.     }
 28.     qui xtset idauniq tt
 29.     capture drop d_*
 30.     qui tab tt, gen(d_)
 31.     drop d_1
 32.     local exog "age working wealth_ihs lnincome msd2 msd3 msd4 d_*"
 33. 
.     forvalues spec = 1/2 {
 34.         local col = cond(`spec' == 1, "collapse", "")
 35.         capture noisily xtabond2 `y' L.`y' sss `exog' if touse, gmm(L.`y',
>  lag(1 3) `col') gmm(sss, lag(1 3) `col') iv(`exog', eq(diff)) noleveleq twos
> tep robust
 36.         if _rc {
 37.             di "xtabond2 failed for `y' spec `spec' (rc=" _rc ")"
 38.             post `foo' ("`y'") (`isbin') (`isremap') (`spec') (.) (.) (.) 
> (.) (.) (.) (.) (.) (.) (.) (.) (`b_fe_all') (`se_fe_all')
 39.         }
 40.         else {
 41.             post `foo' ("`y'") (`isbin') (`isremap') (`spec') (e(N)) (e(N_
> g)) (e(j)) (_b[sss]) (_se[sss]) (_b[L.`y']) (_se[L.`y']) (e(ar1p)) (e(ar2p)) 
> (e(hansenp)) (e(sarganp)) (`b_fe_all') (`se_fe_all')
 42.         }
 43.     }
 44.     restore
 45. }

