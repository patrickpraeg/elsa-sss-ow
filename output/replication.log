. 
. foreach y of varlist $continuous $binary {
  2.     di "diff SEs: `y'"
  3.     foreach sch in x l {
  4.         local w   = cond("`sch'" == "x", "xwgt", "lwgt")
  5.         local sv  = cond("`sch'" == "x", "s_xw", "s_lw")
  6.         capture drop _smp _rw _ru _ew _eu _sw _su _Sw _Su _tag _q1 _q2 _q3
>  _q4 _q5 _q6
  7.         gen byte _smp = `sv' & !missing(`y')
  8. 
.         qui areg sss $controls i.wave [pw=`w'] if _smp, absorb(idauniq)
  9.         qui predict double _rw if _smp, residuals
 10.         qui areg sss $controls i.wave if _smp, absorb(idauniq)
 11.         qui predict double _ru if _smp, residuals
 12. 
.         qui areg `y' sss $controls i.wave [pw=`w'] if _smp, absorb(idauniq)
 13.         local bw = _b[sss]
 14.         qui predict double _ew if _smp, residuals
 15.         qui areg `y' sss $controls i.wave if _smp, absorb(idauniq)
 16.         local bu = _b[sss]
 17.         qui predict double _eu if _smp, residuals
 18. 
.         qui gen double _sw = `w' * _rw * _ew if _smp
 19.         qui gen double _su = _ru * _eu if _smp
 20.         qui egen double _Sw = total(_sw) if _smp, by(idauniq)
 21.         qui egen double _Su = total(_su) if _smp, by(idauniq)
 22.         qui egen byte _tag = tag(idauniq) if _smp
 23.         qui gen double _q1 = _Sw^2    if _tag == 1
 24.         qui gen double _q2 = _Su^2    if _tag == 1
 25.         qui gen double _q3 = _Sw*_Su  if _tag == 1
 26.         qui gen double _q4 = `w' * _rw^2 if _smp
 27.         qui gen double _q5 = _ru^2       if _smp
 28.         qui gen double _q6 = `w' * _rw * `y' if _smp
 29.         qui summarize _q1, meanonly
 30.         local s11 = r(sum)
 31.         local G   = r(N)
 32.         qui summarize _q2, meanonly
 33.         local s22 = r(sum)
 34.         qui summarize _q3, meanonly
 35.         local s12 = r(sum)
 36.         qui summarize _q4, meanonly
 37.         local Aw = r(sum)
 38.         qui summarize _q5, meanonly
 39.         local Au = r(sum)
 40.         qui summarize _q6, meanonly
 41.         local bw_fwl = r(sum) / `Aw'
 42. 
.         local c    = `G' / (`G' - 1)
 43.         local vw   = `c' * `s11' / (`Aw'^2)
 44.         local vu   = `c' * `s22' / (`Au'^2)
 45.         local cv   = `c' * `s12' / (`Aw' * `Au')
 46.         local d    = `bw' - `bu'
 47.         local d_se = sqrt(`vw' + `vu' - 2 * `cv')
 48.         local sew  = sqrt(`vw')
 49.         local seu  = sqrt(`vu')
 50.         local gap  = `bw_fwl' - `bw'
 51.         local `sch'_d   = `d'
 52.         local `sch'_dse = `d_se'
 53.         local `sch'_sew = `sew'
 54.         local `sch'_seu = `seu'
 55.         local `sch'_gap = `gap'
 56.     }
 57.     post `bar' ("`y'") ///
>         (`x_d') (`x_dse') (`x_sew') (`x_seu') (`x_gap') ///
>         (`l_d') (`l_dse') (`l_sew') (`l_seu') (`l_gap')
 58. }
