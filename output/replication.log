  5.         file write tbl "\multicolumn{5}{l}{\emph{`heading`b''}} \\" _n
  6.         local prev = `b'
  7.     }
  8. 
.     local dec = max(2, min(5, ceil(-log10(dec_se[`r']))))
  9.     if binary[`r'] local dec = 2
 10.     if depvar[`r'] == "lhscrp" local dec = 1
 11. 
.     local e   = string(est[`r'], "%12.`dec'f")
