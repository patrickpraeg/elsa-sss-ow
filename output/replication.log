 13.     local u   = string(ub[`r'],  "%12.`dec'f")
 14.     foreach v in e l u {
 15.         if real("``v''") == 0 local `v' = subinstr("``v''", "-", "", 1)
 16.     }
 17.     foreach v in e l u {
 18.         local `v' = subinstr("``v''", "-", "`dollar'-`dollar'", 1)
 19.     }
 20.     local orig "`e' [`l', `u']"
 21.     if bonf[`r'] local orig "\textbf{`e'} [`l', `u']"
 22. 
.     local sdv  = string(fe[`r'],    "%12.3f")
 23.     local sdl  = string(sd_lb[`r'], "%12.3f")
 24.     local sdu  = string(sd_ub[`r'], "%12.3f")
 25.     foreach v in sdv sdl sdu {
 26.         if real("``v''") == 0 local `v' = subinstr("``v''", "-", "", 1)
 27.         local `v' = subinstr("``v''", "-", "`dollar'-`dollar'", 1)
 28.     }
 29.     if binary[`r'] local sdtxt "---"
 30.     else if bonf[`r'] local sdtxt "\textbf{`sdv'} [`sdl', `sdu']"
 31.     else           local sdtxt "`sdv' [`sdl', `sdu']"
 32. 
.     if binary[`r'] {
 33.         local msd = string(100 * raw_mean[`r'], "%12.1f") + "\%"
 34.     }
 35.     else if depvar[`r'] == "lhscrp" {
 36.         local msd = string(exp(raw_mean[`r']), "%12.2f") + " (log-SD " + s
> tring(raw_sd[`r'], "%12.2f") + ")"
 37.     }
 38.     else {
 39.         local mdec = cond(raw_sd[`r'] < 0.05, 4, cond(raw_sd[`r'] < 1, 3, 
> cond(raw_sd[`r'] < 10, 2, 1)))
 40.         local msd = string(raw_mean[`r'], "%12.`mdec'f") + " (" + string(r
> aw_sd[`r'], "%12.`mdec'f") + ")"
 41.     }
 42. 
.     file write tbl "`=lab_txt[`r']' & `=unit[`r']' & `msd' & `sdtxt' & `orig'
>  \\" _n
 43. }
